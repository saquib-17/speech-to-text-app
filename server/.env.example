# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas M0 or Local)
MONGO_URI=mongodb://localhost:27017/speechscribe

# Authentication (Generate a high-entropy 32+ char secret)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Speech Recognition (Optional - Server starts and operates mock if omitted)
DEEPGRAM_API_KEY=your_deepgram_api_key_optional

# AI Intelligence (Optional - Server starts and operates gracefully if omitted)
GEMINI_API_KEY=your_gemini_api_key_optional
GEMINI_MODEL=gemini-3.8-flash
# Optional Fallback Model: Only engaged if primary returns 503 after all retries (Disabled by default)
GEMINI_FALLBACK_MODEL=
# Request Timeout in Milliseconds (Default: 15000ms / 15s)
GEMINI_TIMEOUT_MS=15000
# Maximum Retries for Transient 503 Server Errors (Default: 2)
GEMINI_MAX_RETRIES=2

